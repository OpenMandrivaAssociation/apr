+++ apr-1.7.6/build/buildcheck.sh	2026-02-14 00:59:42.060275980 +0100
@@ -41,8 +41,11 @@ fi
 
 # Require libtool 1.4 or newer
 if test -z "$libtool"; then
-  libtool=`build/PrintPath glibtool1 glibtool libtool libtool15 libtool14`
+  libtool=`build/PrintPath slibtool glibtool1 glibtool libtool libtool15 libtool14`
 fi
+if $libtool --version 2>/dev/null |grep -q slibtool; then
+  echo "buildconf: slibtool version $($libtool --version) (ok)"
+else
 lt_pversion=`$libtool --version 2>/dev/null|sed -e 's/([^)]*)//g;s/^[^0-9]*//;s/[- ].*//g;q'`
 if test -z "$lt_pversion"; then
   echo "buildconf: libtool not found."
@@ -67,6 +70,7 @@ else
     res=1
   fi
 fi
+fi
 
 exit $res
 
